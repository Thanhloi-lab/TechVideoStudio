# Local workspace agent adapters & MCP configs generated by `node setup.mjs`
.agents/
.claude/
.mcp.json

# Large rendered video outputs, generated TTS audio & reference files
*.mp4
*.webm
*.mp3
*.wav
ref/

# Generated course roadmaps, lesson scripts, subtitles, audio & per-episode state (local only)
/*/episodes/
/*/state/
/*/course.json
/*/curriculum.md

# Engine runtime caches, local credentials/preferences, env secrets & Python bytecode
engine/.voice_preview_cache/
engine/__pycache__/
__pycache__/
engine/.ai_queue.json
engine/.ai_credentials.json
engine/.ai_preferences.json
.env
.env.*
!.env.example
*.pyc

# Temporary, log, backup & OS files
*.tmp
*.bak
*.log
.DS_Store
Thumbs.db
